{
  "name": "@witness-ai/opencode",
  "mcpName": "io.github.IngTian/witness",
  "version": "0.7.9",
  "description": "Distills your Claude Code / OpenCode sessions — or any text corpus you ingest — into a dated history of how its subject changed, queryable by your agent over MCP.",
  "type": "module",
  "main": "./witness.js",
  "exports": "./witness.js",
  "bin": {
    "witness": "bin/witness.js"
  },
  "scripts": {
    "check": "node --test ./*.test.js ./bin/*.test.js",
    "prepublishOnly": "../../scripts/stage-npm-opencode.sh --build"
  },
  "files": [
    "witness.js",
    "bin/",
    "!bin/*.test.js",
    "prompts/",
    "README.md"
  ],
  "optionalDependencies": {
    "@witness-ai/opencode-darwin-arm64": "0.7.9",
    "@witness-ai/opencode-linux-x64": "0.7.9",
    "@witness-ai/opencode-win32-x64": "0.7.9",
    "@witness-ai/opencode-win32-arm64": "0.7.9"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "opencode",
    "memory",
    "ai-memory",
    "self-improvement",
    "reflection",
    "second-brain",
    "personal-knowledge-management",
    "knowledge-distillation",
    "temporal",
    "provenance",
    "growth",
    "llm",
    "coding-agent",
    "bitemporal",
    "change-tracking",
    "corpus-analysis",
    "text-mining",
    "distillation",
    "agent-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngTian/witness.git",
    "directory": "npm/opencode"
  },
  "publishConfig": {
    "access": "public"
  }
}
